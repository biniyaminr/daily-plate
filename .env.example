# Copy to .env.local for local development. Placeholders only; never commit real values.
# Supabase dashboard → Project Settings → API (or "Connect").

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...). The legacy "anon" key also works via
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Both are public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only key for photo food analysis (Claude API). Set it in Vercel's
# Environment Variables, never in NEXT_PUBLIC_* or browser code. Without it the
# photo log says it isn't switched on; everything else works.
ANTHROPIC_API_KEY=

# Not used by this app. Do NOT add the Supabase service_role / secret key anywhere.
